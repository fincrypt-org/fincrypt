# Fincrypt server configuration — copy to .env and fill in real values.
# The server reads plain environment variables; .env is gitignored.

# "dev" or "prod" (prod enables strict CSP and forbids DEV_ORIGIN)
ENV=dev

# HTTP listen port
PORT=8080

# slog level: debug | info | warn | error
LOG_LEVEL=info

# Postgres connection string
DATABASE_URL=postgres://fincrypt:fincrypt@localhost:5432/fincrypt?sslmode=disable

# Allowed CORS origin for the Vite dev server (dev only; leave empty in prod)
DEV_ORIGIN=http://localhost:5173

# Comma-separated base64 32-byte cookie-signing keys (current + optional rotation).
# Generate: openssl rand -base64 32
SESSION_KEYS=REPLACE_WITH_openssl_rand_base64_32